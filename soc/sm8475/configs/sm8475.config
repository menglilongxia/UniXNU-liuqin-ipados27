# Qualcomm SM8475 (Snapdragon 8+ Gen 1, cape).
# Architecture settings (4 KiB stage 1, PAC, PAN, arch timer, ArmDTPlatform)
# come from profiles/arch/arm64e (or profiles/arch/arm64 for legacy targets).
#
# Adreno 730 nodes are declared in dts/sm8475.dtsi with status = "disabled"
# until a dedicated Adreno 730 + AdrenoMetal provider is ported.
